# Base URL of the backend API (see ../API_CONTRACT.md). Defaults to
# http://localhost:8787 if unset — copy this file to .env.local and change it
# for staging/prod.
VITE_API_URL=http://localhost:8787

# --- Dev-only flags, do not set these in production ---
# Set to "true" to use an in-memory mock backend instead of the real API, so
# you can click through every job state without a live server.
# VITE_USE_MOCK_API=true
# Set to "true" (with VITE_USE_MOCK_API=true) to simulate a dead backend.
# VITE_MOCK_HEALTH_DOWN=true
