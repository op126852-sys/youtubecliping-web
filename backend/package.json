{
  "name": "youtube-clip-studio-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API for YouTube Clip Studio: yt-dlp + ffmpeg orchestration behind an Express/TypeScript REST API.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test:pipeline": "tsx test/ffmpeg-pipeline.test.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=18"
  }
}
